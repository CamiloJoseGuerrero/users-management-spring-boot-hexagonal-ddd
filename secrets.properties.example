# Copie este archivo como "secrets.properties" en la raiz del proyecto.
# secrets.properties esta en .gitignore: sus claves NUNCA se suben a GitHub.
# Cualquier valor aqui sobreescribe al de application.properties.

# --- Base de datos: MySQL local ---
db.engine=mysql
db.host=localhost
db.port=3306
db.name=crud_usuarios
db.username=root
db.password=1234567

